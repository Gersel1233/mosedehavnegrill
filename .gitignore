node_modules/
test-results/
# Værktøjernes arbejdsmappe. Den ligger IKKE i test-results, fordi
# Playwright rydder den mappe når det starter – og en testkørsel
# midt i en filmoptagelse slettede billederne under ffmpeg.
.arbejde/
playwright-report/
.DS_Store
*.log
__pycache__/

# De ubearbejdede kamerafiler. De ligger i git-historikken – de
# tre første fotos og videoen på commit c05b208 og 92ec1cb,
# udsigten til isfilmen på ce1223a – men 34 MB skal ikke hentes
# ned hver gang nogen kloner repoet. De bearbejdede udgaver ligger
# i billeder/ og assets/, og vaerktoej/lav-fotos.py laver dem.
original/

# Skærmbilleder fra en prøvekørsel. De laves for at VISE noget i
# en samtale — en fane, en fejl, et layout — og hører ikke i
# repoet: de er 100 kB binært hver, de bliver forældede i samme
# sekund koden ændrer sig, og de kan altid laves igen.
#
# ⚠️ De blev comittet ved et uheld 26/8 med et `git add -A`, og
# det er dét, de her linjer forhindrer. Ligger et billede i
# repoet, som SKAL være der (fotos til siden), hører det i
# billeder/ eller assets/.
dagsstyring.png
maanedsnet.png
overblik.png
bordsiden-*.png

# Playwright MCP-serverens egen arbejdsmappe (spor, profiler).
# Serveren i .mcp.json laver den, når nogen bruger browseren som
# værktøj — den er pr. session og hører ikke i repoet.
.playwright-mcp/
